# Copy this file to .env and fill it in. NEVER commit .env: it is listed in .gitignore.
# Check it with: npm run check-env

# development | production
NODE_ENV=development

# Port of the API server. Vite forwards /api to it in development.
PORT=4000

# MongoDB connection string. Transfers need a replica set: MongoDB Atlas (free tier) works out of the box.
# Local alternative: start mongod with --replSet rs0, run rs.initiate() once, then use
#   mongodb://localhost:27017/?replicaSet=rs0
# In production the string must contain a user and password and use TLS (mongodb+srv:// does).
MONGODB_URI=
MONGODB_DB=tunibudget

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public address of the app (used for the CSRF Origin check and the password reset links).
# Development: http://localhost:5173   Production: must start with https://
APP_URL=http://localhost:5173

# --- HTTPS (production) ---
# Either give the server a certificate...
TLS_CERT_FILE=
TLS_KEY_FILE=
# ...or, when a host or reverse proxy (Render, Railway, Nginx...) handles HTTPS in front of the
# server, set the number of proxies to trust (usually 1).
TRUST_PROXY=0

# --- Sessions and reset links ---
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=30
RESET_TOKEN_MINUTES=15

# --- Admin and monitoring ---
# Comma-separated IPs allowed to use /api/admin (empty = any IP, still admin login only).
ADMIN_IP_ALLOWLIST=
# HTTPS webhook (Slack, Discord...) that receives suspicious-activity alerts.
ALERT_WEBHOOK_URL=
